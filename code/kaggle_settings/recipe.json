{
  "protocol": "siamseg_sfuda_b2_v1",
  "task": "vh2pd",
  "size": 512,
  "batch_size": 6,
  "base_lr": 2e-05,
  "momentum": 0.9,
  "weight_decay": 0.01,
  "lr_power": 1.0,
  "checkpoint_period": 500,
  "warm": {
    "steps": 20000,
    "lr_max_iter": 32000,
    "ema": 0.99,
    "ema_interval": 12,
    "meta": false,
    "meta_top_k": 0.25,
    "meta_update": 1000
  },
  "snd": {
    "steps": 12000,
    "lr_max_iter": 32000,
    "ema": 0.999,
    "ema_interval": 1,
    "meta": true,
    "meta_top_k": 0.01,
    "meta_update": 3000
  },
  "meta-off": {
    "steps": 12000,
    "lr_max_iter": 32000,
    "ema": 0.999,
    "ema_interval": 1,
    "meta": false,
    "meta_top_k": 0.01,
    "meta_update": 3000
  },
  "candidate_top_k": 0.5,
  "candidate_update": 3000,
  "eval_period": 1000
}